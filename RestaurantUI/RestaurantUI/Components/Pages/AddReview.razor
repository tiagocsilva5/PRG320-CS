@page "/review/{Id:int}"
@rendermode InteractiveServer
@inject FakeRestaurantService Service
@inject NavigationManager Nav

<h3>Add Review for @restaurant?.Name</h3>

<div>
    <label>Reviewer</label>
    <input @bind="review.Reviewer" />
</div>
<div>
    <label>Comment</label>
    <input @bind="review.Comment" />
</div>
<div>
    <label>Rating (1-5)</label>
    <input type="number" min="1" max="5" @bind="review.Rating" />
</div>

<button @onclick="Submit">Submit</button>
<button @onclick="Cancel">Cancel</button>

@code {
    [Parameter] public int Id { get; set; }

    private Restaurant restaurant;
    private Review review = new Review();

    protected override void OnParametersSet()
    {
        restaurant = Service.GetById(Id);
    }

    void Submit()
    {
        Service.AddReview(Id, review);
        Nav.NavigateTo($"/reviews/{Id}");
    }

    void Cancel()
    {
        Nav.NavigateTo("/restaurants");
    }
}